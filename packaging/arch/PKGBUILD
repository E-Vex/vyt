# Maintainer: E-Vex <contact@e-vex.dev>
pkgname=vyt
pkgver=2.0.0
pkgrel=1
pkgdesc="tiny C wrapper around yt-dlp and mpv"
url="https://github.com/E-Vex/vyt"
arch=('x86_64')
license=('MIT')
depends=('yt-dlp' 'mpv')
makedepends=('gcc' 'make')
source=("https://github.com/E-Vex/vyt/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    make
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 vyt "$pkgdir/usr/bin/vyt"
    install -Dm644 man/vyt.1 "$pkgdir/usr/share/man/man1/vyt.1"
}
